#!/bin/sh
# Wento Unix/Linux/macOS Configure Script
# Created by Fructose
# Generates config.unix.h and Makefile for Unix-like operating systems.

set -e

PREFIX="/usr/local"
CXX_OVERRIDE=""

for arg in "$@"; do
  case "$arg" in
    --prefix=*)
      PREFIX="${arg#*=}"
      ;;
    --cxx=*)
      CXX_OVERRIDE="${arg#*=}"
      ;;
    --help|-h)
      echo "Wento Configure Script (by Fructose)"
      echo "Usage: ./configure [--prefix=/usr/local] [--cxx=g++]"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
  esac
done

OS_NAME="$(uname -s 2>/dev/null || echo Unknown)"
echo "Configuring Wento 1.0.0 (by Fructose) for ${OS_NAME}..."

# Detect C++17 compiler
CXX=""
if [ -n "$CXX_OVERRIDE" ]; then
  if command -v "$CXX_OVERRIDE" >/dev/null 2>&1; then
    CXX="$CXX_OVERRIDE"
  else
    echo "Error: Requested compiler '$CXX_OVERRIDE' not found." >&2
    exit 1
  fi
elif command -v g++ >/dev/null 2>&1; then
  CXX="g++"
elif command -v clang++ >/dev/null 2>&1; then
  CXX="clang++"
else
  echo "Warning: No C++17 compiler (g++ or clang++) detected in PATH; defaulting Makefile CXX=g++."
  CXX="g++"
fi

# Detect Unix audio playback command
AUDIO_CMD="none"
if [ "$OS_NAME" = "Darwin" ] && command -v afplay >/dev/null 2>&1; then
  AUDIO_CMD="afplay"
elif command -v paplay >/dev/null 2>&1; then
  AUDIO_CMD="paplay"
elif command -v aplay >/dev/null 2>&1; then
  AUDIO_CMD="aplay"
elif command -v ffplay >/dev/null 2>&1; then
  AUDIO_CMD="ffplay -nodisp -autoexit -loglevel quiet"
fi

# Detect curl for HTTPS audio & community note registry
HAS_CURL=0
if command -v curl >/dev/null 2>&1; then
  HAS_CURL=1
fi

echo "  C++ Compiler    : $CXX"
echo "  Install Prefix  : $PREFIX"
echo "  Audio Backend   : $AUDIO_CMD"
echo "  HTTPS (curl)    : $HAS_CURL"

# Generate config.unix.h
cat > config.unix.h <<EOF
/* Auto-generated by ./configure for Unix/Linux/macOS */
#ifndef WENTO_CONFIG_UNIX_H
#define WENTO_CONFIG_UNIX_H

#define WENTO_VERSION "1.0.0"
#define WENTO_CREATOR "Fructose"
#define WENTO_PLATFORM_NAME "${OS_NAME}"
#define WENTO_OS_UNIX 1
#define WENTO_SAMPLE_RATE 44100
#define WENTO_CHANNELS 1
#define WENTO_BITS_PER_SAMPLE 16
#define WENTO_AUDIO_PLAYER "${AUDIO_CMD}"
#define WENTO_HAS_CURL ${HAS_CURL}
#define WENTO_PATH_SEP '/'
#define WENTO_DEFAULT_REGISTRY_URL "https://wento-registry.local/api/notes"

#endif /* WENTO_CONFIG_UNIX_H */
EOF

# Generate Makefile
cat > Makefile <<EOF
# Auto-generated by ./configure for Wento (${OS_NAME})
# Creator: Fructose

CXX      := ${CXX}
CXXFLAGS := -std=c++17 -O2 -Wall -Wextra -I. -DWENTO_USE_UNIX_CONFIG
LDFLAGS  := -lm -lpthread
PREFIX   := ${PREFIX}
BINDIR   := \$(PREFIX)/bin
DATADIR  := \$(PREFIX)/share/wento

TARGET   := wento
SRCS     := src/main.cpp src/interpreter.cpp src/synth.cpp src/registry.cpp
OBJS     := \$(SRCS:.cpp=.o)

.PHONY: all install uninstall clean test

all: \$(TARGET)

\$(TARGET): \$(OBJS)
	\$(CXX) \$(CXXFLAGS) -o \$@ \$^ \$(LDFLAGS)
	@echo "Built \$(TARGET) successfully for ${OS_NAME}."

src/%.o: src/%.cpp src/wento.hpp src/interpreter.hpp src/synth.hpp src/registry.hpp config.unix.h
	\$(CXX) \$(CXXFLAGS) -c \$< -o \$@

install: \$(TARGET)
	mkdir -p \$(DESTDIR)\$(BINDIR)
	mkdir -p \$(DESTDIR)\$(DATADIR)
	cp \$(TARGET) \$(DESTDIR)\$(BINDIR)/\$(TARGET)
	chmod 755 \$(DESTDIR)\$(BINDIR)/\$(TARGET)
	cp README.md LICENSE MANUAL.md AGENTS.md \$(DESTDIR)\$(DATADIR)/
	@echo "Installed wento to \$(DESTDIR)\$(BINDIR)/\$(TARGET)"

uninstall:
	rm -f \$(DESTDIR)\$(BINDIR)/\$(TARGET)
	rm -rf \$(DESTDIR)\$(DATADIR)

test: \$(TARGET)
	./\$(TARGET) readme >/dev/null
	./\$(TARGET) license >/dev/null
	./\$(TARGET) manual >/dev/null
	./\$(TARGET) agents >/dev/null
	./\$(TARGET) command "set tempo = 130"
	@echo "All CLI smoke checks passed."

clean:
	rm -f \$(OBJS) \$(TARGET)
EOF

echo "Generated config.unix.h and Makefile. Run 'make' to compile Wento."
